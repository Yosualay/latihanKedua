const products = [
    { id: 1, title: "Laptop" },
    { id: 2, title: "Smartphone" },
    { id: 3, title: "Headphones" }
];

function linearSearchProduct(products, id) {
    for (let i = 0; i < products.length; i++) {
        if (products[i].id === id) {
            return products[i];
        }
    }

    return undefined;
}

console.log(linearSearchProduct(products, 2));
console.log(linearSearchProduct(products, 99));
// latihan 7
function binarySearch(arr, target) {
    let left = 0;
    let right = arr.length - 1;

    while (left <= right) {
        const mid = Math.floor((left + right) / 2);

        if (arr[mid] === target) {
            return mid;
        }

        if (arr[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    return -1;
}

const hitung = [10, 20, 30, 40, 50, 60, 70];

console.log(binarySearch(hitung, 50));
console.log(binarySearch(hitung, 99));